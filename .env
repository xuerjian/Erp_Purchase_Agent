# .env.test 测试环境
ENV=test
API_BASE_URL=http://test-api:8080
REDIS_URL=redis://redis-test:6379
MCP_SERVER_PORT=8091
LOG_LEVEL=INFO
# 密钥，测试专用
LLM_API_KEY=sk_test_xxxx

#远程沙箱存储技能文件的路径
SANDBOX_SKILLS_PATH=/skills
# 本地技能资源目录（项目内的路径，相对于项目根）
LOCAL_SKILLS_PATH=/skills

# 沙箱内数据文件存放的路径
SANDBOX_DATA_PATH=/data

# 从沙箱将文件下载到本地的路径
LOCAL_DOWNLOAD_DIR=/download

# Agent记忆文件名
AGENTS_MD_FILENAME=/AGENTS.md
# 本地的Agent记忆文件
LOCAL_AGENTS_MD=/AGENTS.md

# 用户偏好文件名
USER_PREF_FILENAME=preferences.md

# 本地子Agent配置路径
LOCAL_SUBAGENT_PATH=/agent/subagents

# 沙箱内分析中间文件路径
SANDBOX_ANALYSIS_PATH=/analysis

# 沙箱内用户私有记忆存放路径
SANDBOX_MEMORIES_PATH=/memories

# 技能持久化路径
PERSISTED_SKILLS_ROOT=/persisted-skills
# 技能存储命名空间名
STORE_SKILLS_NAMESPACE=(skills,)

# ---------- MongoDB 配置  用redis取代 ----------
MGDB_URI=mongodb://root:xej123@localhost:27017/?authSource=admin
MGDB_DATABASE_NAME=context_db
MGDB_CHECKPOINTER_COLLECTION=checkpointer

#远程沙箱api_key 框架内部会自动获取设置
OPEN_SANDBOX_API_KEY=
#远程沙箱地址，框架内部会自动获取设置否者则会获取默认的本地localhost:8080
OPEN_SANDBOX_DOMAIN=

#mcp相关
ERP-API.URL=http://127.0.0.1:8000/mcp
ERP-API.TRANSPORT=streamable_http

ANALYSIS.URL=https://mcp.api-inference.modelscope.net/af3893df5be041/mcp
ANALYSIS.TRANSPORT=streamable_http

# 本地下载目录（从沙箱下载文件的目标路径）
DOWNLOAD_DIR=/download

#大模型 阿里千文大模型
